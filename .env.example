# ==============================================================================
# Master Environment Configuration Template
# Rakib Silk & Fashion (Tally Khata)
#
# Duplicate this file to .env in backend/ or .env.local in frontend/
# DO NOT COMMIT ACTUAL PASSWORDS OR API KEYS TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (backend/.env)
# ------------------------------------------------------------------------------

# Server Listening Port (Cloud hosts like Render set this automatically)
PORT=5000

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/?retryWrites=true&w=majority
DB_NAME=Silk_and_fashion

# Cloudinary Media Storage (Optional: Required for saree image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# EmailJS Service (Optional: Required for account verification passcode emails)
EMAILJS_SERVICE_ID=service_gifq25t
EMAILJS_TEMPLATE_ID=template_fxkonbp
EMAILJS_USER_ID=S-Rf-rtEkTugqgxM4
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# ------------------------------------------------------------------------------
# 2. Frontend Web Application (frontend/.env.local)
# ------------------------------------------------------------------------------

# Base URL pointing to your backend REST API
# Local dev: http://localhost:5000/v1
# Production: https://your-backend-app.onrender.com/v1
VITE_API_URL=https://rakib-fashion-backend.onrender.com/v1
